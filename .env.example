# MySQL
MYSQL_DATABASE=cloud
MYSQL_USER=cloud_user
MYSQL_PASSWORD=cloud_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306

# Host-Ports
PHPMYADMIN_PORT=8080
BACKEND_PORT=5000
FRONTEND_PORT=5173

# Absoluter Pfad auf dem Host für Fotos/Videos
MEDIA_HOST_PATH=C:/mmd_work/cloud-fest

# Backend-Optionen
COOKIE_SECURE=false
REGISTRATION_ENABLED=false
MAX_UPLOAD_BYTES=2147483648
# Speicherlimit pro User (225 GB)
STORAGE_QUOTA_BYTES=241591910400
WAITRESS_THREADS=16

# Leistung: Datenbank
MYSQL_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=64
DB_POOL_SIZE=16

# Leistung: Caches im Backend
SESSION_CACHE_TTL=30
SESSION_CLEANUP_INTERVAL=300
MEDIA_META_CACHE_MAX=50000
THUMB_CACHE_MB=192

# Leistung: Thumbnails
THUMB_MAX_EDGE=512
THUMB_QUALITY=80
ON_DEMAND_THUMB_WORKERS=3
MAX_IMAGE_PIXELS=80000000
VIDEO_THUMB_SEEK=1
VIDEO_THUMB_TIMEOUT=30

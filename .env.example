# MySQL
MYSQL_DATABASE=cloud
MYSQL_USER=cloud_user
MYSQL_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PORT=3306

# Host-Ports
PHPMYADMIN_PORT=8080
BACKEND_PORT=5000
FRONTEND_PORT=5173

# Absoluter Pfad auf dem Host für Fotos/Videos (wird nach /data/media gemountet)
# Windows Beispiel: C:/mmd_work/cloud-fest
# Linux/macOS Beispiel: /var/lib/cloud-foto-video/media
MEDIA_HOST_PATH=./data/media

# Backend-Optionen (optional)
# COOKIE_SECURE=true  # nur hinter HTTPS
MAX_UPLOAD_BYTES=2147483648
WAITRESS_THREADS=8

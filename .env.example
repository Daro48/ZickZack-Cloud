# MySQL
MYSQL_DATABASE=cloud
MYSQL_USER=cloud_user
MYSQL_PASSWORD=cloud_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306

# Host-Ports
PHPMYADMIN_PORT=8080
BACKEND_PORT=5000
FRONTEND_PORT=5173

# Absoluter Pfad auf dem Host für Fotos/Videos
MEDIA_HOST_PATH=C:/mmd_work/cloud-fest

# Backend-Optionen
COOKIE_SECURE=false
REGISTRATION_ENABLED=false
MAX_UPLOAD_BYTES=2147483648
WAITRESS_THREADS=16

# Leistung: Datenbank
# Muss in den freien RAM des Hosts passen, sonst startet MySQL nicht.
# 256M reichen fuer die Metadaten locker; nur erhoehen wenn RAM uebrig ist.
MYSQL_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=64
# Sollte kleiner als MYSQL_MAX_CONNECTIONS und >= WAITRESS_THREADS sein.
DB_POOL_SIZE=16

# Leistung: Caches im Backend
# Sekunden, die ein Session-Lookup im Prozess gecacht wird.
SESSION_CACHE_TTL=30
# Sekunden zwischen zwei Aufraeumlaeufen fuer abgelaufene Sessions.
SESSION_CLEANUP_INTERVAL=300
MEDIA_META_CACHE_MAX=50000
# Arbeitsspeicher fuer bereits ausgelieferte Thumbnails. Spart auf einem
# Bind-Mount den Grossteil der Antwortzeit.
THUMB_CACHE_MB=192

# Leistung: Thumbnails
THUMB_MAX_EDGE=512
THUMB_QUALITY=80
# Gleichzeitige Thumbnail-Erzeugungen, wenn ein Bild noch keins hat.
ON_DEMAND_THUMB_WORKERS=3
# Obergrenze fuer die Pixelzahl eines Bildes, deckelt den Speicher pro Dekodierung.
MAX_IMAGE_PIXELS=80000000
# Sekunde im Video, aus der das Vorschaubild kommt. Bei kuerzeren Clips wird
# automatisch der erste Frame genommen.
VIDEO_THUMB_SEEK=1
# Abbruch nach so vielen Sekunden, falls ffmpeg an einer Datei haengen bleibt.
VIDEO_THUMB_TIMEOUT=30
